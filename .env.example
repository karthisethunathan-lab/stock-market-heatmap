# ==========================================
# MarketPulse Environment Configuration
# ==========================================

# Server configuration
PORT=5000
NODE_ENV=development

# Finnhub API Key (free tier: https://finnhub.io/)
# Required for analyst consensus, company profiles, and financial metrics
# If omitted or left empty, server gracefully falls back to Yahoo data
FINNHUB_API_KEY=your_free_finnhub_api_key_here

# Allowed origins for CORS (comma-separated in production)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000
